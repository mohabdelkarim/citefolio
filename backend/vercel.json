{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "app/main.py": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cleanup?mode=hourly",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cleanup?mode=daily",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cleanup?mode=weekly",
      "schedule": "0 4 * * 0"
    }
  ]
}
